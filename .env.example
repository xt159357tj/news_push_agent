# Copy to .env and fill in real values
APP_ENV=development
DEBUG=true

# Database (MySQL) — 需要先创建数据库 news_agent
# 格式: mysql+asyncmy://user:password@host:port/dbname?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://root:yourpassword@127.0.0.1:3306/news_agent?charset=utf8mb4
WORKSPACE_ROOT=./workspace

# LLM (OpenAI-compatible) — DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
AGENT_MAX_STEPS=12

# Embedding model (OpenAI-compatible) — Qwen qwen3.7-text-embedding
# 把 EMBEDDING_BASE_URL / EMBEDDING_API_KEY 指向能提供该模型 id 的网关，
# 例如 DashScope compatible-mode、vLLM/OneAPI 等。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DIMENSIONS_ENABLED=false

# Hybrid retrieval: FAISS(向量) + BM25(关键词)
# HYBRID_SEARCH_MODE=hybrid        # hybrid | vector | bm25
# HYBRID_SCORING=rrf               # rrf(推荐) | convex(加权融合)
# VECTOR_WEIGHT=0.6                # convex 模式下的向量权重
# FAISS_INDEX_PATH=./data/faiss_index.pkl   # 留空则仅内存

# News
NEWS_PROVIDER=rss
REQUEST_TIMEOUT_SECONDS=15
MAX_ARTICLE_CHARS=5000

# SMTP (可选，用于邮件推送；未配置时简报仍会生成并保存到历史列表)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=news-agent@example.com
